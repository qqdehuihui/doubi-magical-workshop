# AI 学习助手后端环境变量（复制为 .env 后填写，切勿提交真实 Key）

# 模型提供者：mock = 测试数据闭环（默认，无需 Key）；openai = 真实模型
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# 仅 LLM_PROVIDER=openai 时需要，真实 Key 只允许存在后端 .env 中
OPENAI_API_KEY=
# OpenAI 兼容接口地址，留空则使用 OpenAI 官方；例：https://api.deepseek.com/v1
OPENAI_BASE_URL=
# 单次模型调用超时（秒）
LLM_TIMEOUT=90

# Qoder CN Cloud Agents（PAT 认证，Agent/Session/Event API）
# 个人访问令牌（PAT）只允许存在本文件对应的后端 .env 中，切勿写入代码、日志或提交到 Git
QODER_ACCESS_TOKEN=
QODER_API_BASE_URL=https://api.qoder.com.cn
QODER_OPENAPI_BASE_URL=https://openapi.qoder.com.cn
# Cloud Agents 模型标识（以 GET /api/v1/cloud/models 返回的可用模型为准）
QODER_MODEL=ultimate
# Cloud Agents 只读请求超时（秒）
QODER_TIMEOUT=20

# 上传限制
MAX_FILE_MB=50
# 单次处理允许的最大文本量（字符），超出提示分章上传
MAX_GEN_CHARS=60000
# 解析缓存目录，默认使用仓库根目录下的 data/
# DATA_DIR=
